# Copy this to .env and fill in your values.
# .env is gitignored — credentials never leave your machine.

# Coinbase Advanced Trade (https://portal.cdp.coinbase.com)
COINBASE_KEY_NAME=organizations/xxx/apiKeys/yyy
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
...
-----END EC PRIVATE KEY-----"

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY="sk-ant-..."

# Optional, production only. Only needed if the client is hosted at a different
# origin than this server (the default single-process deployment doesn't need it).
# CORS_ORIGIN=https://your-mizan-domain.example.com

# Optional. Runs a full sync automatically every N minutes while the server is
# running, in addition to the manual sync button. Off by default — nothing
# calls external providers until you opt in.
# MIZAN_SYNC_INTERVAL_MINUTES=60

# Optional. Runs a full sync ~2s after the server starts, so you have fresh data
# without clicking "sync now". Gated on staleness (skipped if the last sync was
# within 10 minutes), so `npm run dev` restarting on every file save (tsx watch)
# doesn't trigger a sync on every save. Off by default.
# MIZAN_AUTO_SYNC_ON_STARTUP=true
