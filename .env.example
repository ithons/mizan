# Copy this to .env and fill in your values. .env is gitignored.

# Coinbase Advanced Trade (https://portal.cdp.coinbase.com)
COINBASE_KEY_NAME=organizations/xxx/apiKeys/yyy
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----
...
-----END EC PRIVATE KEY-----"

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY="sk-ant-..."

# Optional, production only. Only needed if the client is hosted at a different
# origin than this server (the default single-process deployment doesn't need it).
# CORS_ORIGIN=https://your-mizan-domain.example.com

# Optional, production only. The interface the server binds to. Defaults to
# 127.0.0.1 (loopback) so the API — which has no auth in front of your financial
# data — isn't reachable from the LAN. Set to 0.0.0.0 only if you deliberately
# want to expose it beyond this machine.
# MIZAN_HOST=0.0.0.0

# Optional. Periodic full sync, ON by default at every 60 minutes. Set another
# positive integer to change the cadence, or 0 to turn the timer off.
# MIZAN_SYNC_INTERVAL_MINUTES=60

# Optional. Full sync ~2s after the server starts, ON by default. Gated on
# staleness (skipped if the last sync was within 10 minutes) so `npm run dev`
# restarting on every file save (tsx watch) doesn't sync on every save.
# Set to false to disable.
# MIZAN_AUTO_SYNC_ON_STARTUP=false

# Optional. Extra host[:port] values the local request guard accepts, comma
# separated. Only needed if you reach the app under a non-standard hostname.
# MIZAN_ALLOWED_HOSTS=mizan.local:3001
