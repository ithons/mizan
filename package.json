{
  "name": "mizan",
  "version": "0.1.0",
  "description": "Local-first personal finance - self-hosted alternative to Monarch Money",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:server && npm run typecheck:client && npm run typecheck:tests && npm run typecheck:scripts",
    "build": "tsc -p tsconfig.server.json && cp -r server/src/db/migrations dist/server/src/db/ && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/src/index.js",
    "db:migrate": "tsx server/src/db/migrate.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@google/genai": "^2.15.0",
    "@napi-rs/keyring": "^1.3.0",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.474.0",
    "morgan": "^1.10.0",
    "openai": "^7.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "string-similarity": "^4.0.4",
    "uuid": "^11.0.5",
    "vite-express": "^0.22.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/string-similarity": "^4.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
